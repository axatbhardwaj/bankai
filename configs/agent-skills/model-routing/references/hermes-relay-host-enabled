#!/usr/bin/env python3
import json
import os
from pathlib import Path

try:
    marker = json.loads(
        (Path(os.environ["HOME"]) / ".config/haoshoku/hermes-relay.json").read_text(
            encoding="utf-8"
        )
    )
except (KeyError, OSError, UnicodeError, json.JSONDecodeError):
    raise SystemExit(1)

raise SystemExit(
    0
    if isinstance(marker, dict)
    and marker.get("version") == 1
    and marker.get("enabled") is True
    else 1
)
